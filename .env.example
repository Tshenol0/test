POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb
JWT_SECRET=change-this-secret-in-production

# --- PaaS / generated-app settings ---
# Subdomains of generated apps look like: <subdomain>.<BASE_DOMAIN>
# yourpaas.localhost works out of the box in most modern browsers with no
# DNS/hosts-file changes (Chrome/Edge resolve *.localhost to 127.0.0.1).
BASE_DOMAIN=yourpaas.localhost
APPS_DB_ADMIN_USER=apps_admin
APPS_DB_ADMIN_PASSWORD=appspassword
